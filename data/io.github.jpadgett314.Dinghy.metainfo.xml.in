<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPLICATION_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Dinghy</name>
  <summary>Manage Linkding bookmarks</summary>
  <description>
    <p>Browse, create and edit Linkding bookmarks with Dinghy. Linkding server required.</p>
    <p>Dinghy is built with libadwaita.</p>
  </description>
  <developer id="tld.vendor">
    <name translate="no">Jacob Padgett</name>
  </developer>
  <url type="homepage">https://github.com/jpadgett314/dinghy</url>
  <url type="vcs-browser">https://github.com/jpadgett314/dinghy</url>
  <url type="bugtracker">https://github.com/jpadgett314/dinghy/issues</url>
  <translation type="gettext">dinghy</translation>
  <launchable type="desktop-id">@APPLICATION_ID@.desktop</launchable>
  <branding>
    <color type="primary" scheme_preference="light">#62a0ea</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <custom>
    <value key="GnomeSoftware::key-colors">[(98, 160, 234), (26, 95, 180)]</value>
  </custom>
  <content_rating type="oars-1.1" />
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <screenshots>
    <screenshot type="default">
      <image>https://github.com/jpadgett314/dinghy/raw/main/data/screenshots/feed-light.png</image>
      <caption>Main bookmark feed</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.1.0" date="2026-11-26">
      <description translate="no">
        <p>Initial release. Features include:</p>
        <ul>
          <li>Single Linkding server connection</li>
          <li>Browse unarchived bookmarks</li>
          <li>Search bookmarks using Linkding query syntax</li>
          <li>Create and edit bookmarks</li>
          <li>Mobile- and desktop-friendly interface</li>
        </ul>
      </description>
    </release>
  </releases>
</component>

