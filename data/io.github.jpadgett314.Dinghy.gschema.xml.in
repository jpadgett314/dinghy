<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="dinghy">
	<schema id="@APPLICATION_ID@" path="@APPLICATION_PATH@">
	  <key name="onboarded" type="b">
	    <default>false</default>
	  </key>
    <key name="api-url" type="s">
      <default>'http://localhost:9090'</default>
    </key>
    <key name="api-token" type="s">
      <default>''</default>
    </key>
	  <key name="max-bookmarks-per-query" type="u">
      <default>100</default>
	  </key>
	</schema>
</schemalist>
