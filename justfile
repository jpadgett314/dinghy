# USAGE: just [--set profile release] {recipe}
profile := 'devel'

app_id := 'io.github.jpadgett314.Dinghy' + if profile == 'release' { '' } else { '.Devel' }
manifest := app_id + '.json'
meson_profile := if profile == 'release' { 'default' } else { 'development' }
meson_dir := if profile == 'release' { '_build_release' } else { '_build' }
branch := if profile == 'release' { 'release' } else { 'devel' }
bundle_file := 'dinghy-' + branch + '.flatpak'

# just --list
default:
    @just --list

# Remove the local Flatpak build directories and artifacts.
clean:
    rm -rf -- .flatpak-builder .flatpak-build .flatpak-repo dinghy*.flatpak _build _build_release

# Install the Flatpak SDK, runtime, and Rust extension from Flathub.
setup:
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    flatpak-builder --user --install-deps-from=flathub --install-deps-only .flatpak-build {{manifest}}

# Build the current checkout and export it to a local Flatpak repository.
build:
    flatpak-builder --user --force-clean --default-branch={{branch}} --repo=.flatpak-repo .flatpak-build {{manifest}}

# Build and install the app, replacing any existing copy.
install: build
    flatpak install --user --reinstall ./.flatpak-repo {{app_id}}//{{branch}}

# Run the installed app.
run:
    flatpak run {{app_id}}//{{branch}}

# Validate the flatpak manifest.
lint-manifest:
    flatpak run --command=flatpak-builder-lint org.flatpak.Builder manifest {{manifest}}

# Validate the local flatpak repository generated by the flatpak build.
lint-repo: build
    flatpak run --command=flatpak-builder-lint org.flatpak.Builder repo .flatpak-repo

# Build an installable bundle, like the CI artifact.
bundle: build
    flatpak build-bundle --runtime-repo=https://dl.flathub.org/repo/flathub.flatpakrepo .flatpak-repo {{bundle_file}} {{app_id}} {{branch}}

# Install a downloaded or locally built bundle (without rebuilding).
install-bundle path=bundle_file:
    flatpak install --user --reinstall "{{path}}"

_setup-once:
    @if [ ! -f "{{meson_dir}}/meson-private/coredata.dat" ]; then {{just_executable()}} --set profile {{profile}} native-setup; fi

# Configure a native build with the regular application ID.
native-setup:
    meson setup "{{meson_dir}}" --prefix="$HOME/.local" -Dprofile={{meson_profile}}

# Compile the configured native build.
native-build: _setup-once
    meson compile -C "{{meson_dir}}"

# Build and install the native app.
native-install: native-build
    meson install -C "{{meson_dir}}"

# Run the native app installed by native-install.
native-run:
    "$HOME/.local/bin/dinghy"

# Regenerate the gettext template at po/dinghy.pot.
pot: _setup-once
    meson compile -C "{{meson_dir}}" dinghy-pot

# Create a vendored release source archive and checksum from committed sources.
dist: _setup-once
    meson dist -C "{{meson_dir}}" --no-tests
