<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="PreferencesDialog" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Preferences</property>
    <property name="search-enabled">false</property>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">General</property>
        <property name="icon-name">preferences-system-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">API Connection</property>
            <property name="description" translatable="yes">
              Configure your server URL and authentication token.
            </property>
            <child>
              <object class="AdwEntryRow" id="server_url_row">
                <property name="title" translatable="yes">Server URL</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="api_token_row">
                <property name="title" translatable="yes">API Token</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
