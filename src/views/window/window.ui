<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="DinghyWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Dinghy</property>
    <property name="default-width">800</property>
    <property name="default-height">680</property>
    <property name="content">
      <object class="AdwToastOverlay">
        <property name="child">
          <object class="GtkStack" id="stack">
            <child>
              <object class="GtkStackPage">
                <property name="name">welcome</property>
                <property name="child">
                  <object class="DinghyWelcome">
                    <property name="connection" bind-source="DinghyWindow" bind-property="connection" bind-flags="sync-create"/>
                    <property name="settings" bind-source="DinghyWindow" bind-property="settings" bind-flags="sync-create"/>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">client</property>
                <property name="child">
                  <object class="DinghyClient" id="client">
                    <property name="connection" bind-source="DinghyWindow" bind-property="connection" bind-flags="sync-create"/>
                    <property name="settings" bind-source="DinghyWindow" bind-property="settings" bind-flags="sync-create"/>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
