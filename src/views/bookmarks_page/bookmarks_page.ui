<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.5"/>
  <template class="BookmarksPage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="toolbar-model">
      <object class="ToolbarModel">
        <signal name="notify::query" handler="on_query_changed" swapped="yes"/>
      </object>
    </property>
    <property name="bookmark-storage">
      <object class="BookmarkStorage" id="bookmark_storage">
        <property name="connection" bind-source="BookmarksPage" bind-property="connection" bind-flags="sync-create"/>
      </object>
    </property>
    <property name="bookmark-feed-model">
      <object class="BookmarkFeedModel">
        <property name="storage">bookmark_storage</property>
        <property name="settings" bind-source="BookmarksPage" bind-property="settings" bind-flags="sync-create"/>
        <signal name="notify::pending" handler="on_pending_changed" swapped="yes"></signal>
      </object>
    </property>
    <signal name="notify::connection" handler="on_connection_changed"/>
    <child>
      <object class="AdwToolbarView">
        <property name="bottom-bar-style">flat</property>
        <binding name="reveal-bottom-bars">
          <closure type="gboolean" function="should_reveal_batch_toolbar">
            <lookup name="selected-count">batch_toolbar</lookup>
            <lookup name="operation-active">batch_toolbar</lookup>
          </closure>
        </binding>
        <child type="bottom">
          <object class="BatchToolbar" id="batch_toolbar">
            <property name="operation" bind-source="BookmarksPage" bind-property="batch-operation" bind-flags="sync-create"/>
            <property name="selected-count" bind-source="bookmark_feed" bind-property="selected-count" bind-flags="sync-create"/>
          </object>
        </child>
        <property name="content">
          <object class="GtkStack" id="status_stack">
            <property name="vexpand">True</property>
            <property name="hexpand">True</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">bookmarks</property>
                <property name="child">
                  <object class="BookmarkFeed" id="bookmark_feed">
                    <property name="model" bind-source="BookmarksPage" bind-property="bookmark-feed-model" bind-flags="sync-create"/>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">loading</property>
                <property name="child">
                  <object class="AdwSpinner">
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="width-request">64</property>
                    <property name="height-request">64</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">no-matches</property>
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="icon-name">system-search-symbolic</property>
                    <property name="title" translatable="yes">No Results Found</property>
                    <property name="description" translatable="yes">Try a different search.</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">no-bookmarks</property>
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="icon-name">bookmark-new-symbolic</property>
                    <property name="title" translatable="yes">No Bookmarks Yet</property>
                    <property name="description" translatable="yes">Add a bookmark to get started.</property>
                  </object>
                </property>
              </object>
            </child>
            <property name="visible-child-name">loading</property>
          </object>
        </property>
      </object>
    </child>
  </template>
  <object class="AdwAlertDialog" id="delete_confirmation">
    <signal name="response" handler="on_delete_confirmation_response" swapped="yes"/>
    <property name="default-response">cancel</property>
    <property name="close-response">cancel</property>
    <responses>
      <response id="cancel" translatable="yes">_Cancel</response>
      <response id="delete" translatable="yes" appearance="destructive">_Delete</response>
    </responses>
  </object>
</interface>
