<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.8"/>
  <template class="BookmarkCard" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="spacing">16</property>
    <binding name="tooltip-text">
      <lookup name="url" type="BookmarkCardModel">
        <lookup name="model">BookmarkCard</lookup>
      </lookup>
    </binding>
    <binding name="favicon">
      <lookup name="favicon-paintable" type="BookmarkCardModel">
        <lookup name="model">BookmarkCard</lookup>
      </lookup>
    </binding>
    <binding name="tag-names">
      <lookup name="tag-names" type="BookmarkCardModel">
        <lookup name="model">BookmarkCard</lookup>
      </lookup>
    </binding>
    <style>
      <class name="card"/>
      <class name="activatable"/>
      <class name="bookmark-card"/>
    </style>
    <child>
      <object class="GtkImage" id="icon_image">
        <property name="valign">start</property>
        <property name="pixel-size">32</property>
        <property name="icon-name">user-bookmarks-symbolic</property>
        <style>
          <class name="dim-label"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="hexpand">True</property>
        <child>
          <object class="GtkLabel" id="title_label">
            <binding name="label">
              <lookup name="title" type="BookmarkCardModel">
                <lookup name="model">BookmarkCard</lookup>
              </lookup>
            </binding>
            <binding name="visible">
              <closure type="gboolean" function="has_text">
                <lookup name="label">title_label</lookup>
              </closure>
            </binding>
            <property name="xalign">0</property>
            <property name="wrap">True</property>
            <property name="wrap-mode">word-char</property>
            <property name="lines">2</property>
            <property name="ellipsize">end</property>
            <style>
              <class name="heading"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="description_label">
            <binding name="label">
              <lookup name="description" type="BookmarkCardModel">
                <lookup name="model">BookmarkCard</lookup>
              </lookup>
            </binding>
            <binding name="visible">
              <closure type="gboolean" function="has_text">
                <lookup name="label">description_label</lookup>
              </closure>
            </binding>
            <property name="xalign">0</property>
            <property name="wrap">True</property>
            <property name="wrap-mode">word-char</property>
            <property name="lines">3</property>
            <property name="ellipsize">end</property>
            <style>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="url_label">
            <binding name="label">
              <lookup name="url" type="BookmarkCardModel">
                <lookup name="model">BookmarkCard</lookup>
              </lookup>
            </binding>
            <binding name="visible">
              <closure type="gboolean" function="has_text">
                <lookup name="label">url_label</lookup>
              </closure>
            </binding>
            <property name="xalign">0</property>
            <property name="ellipsize">middle</property>
            <style>
              <class name="caption"/>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
        <child>
          <object class="AdwWrapBox" id="tags_box">
            <property name="child-spacing">8</property>
            <property name="line-spacing">8</property>
            <binding name="visible">
              <closure type="gboolean" function="has_tags">
                <lookup name="tag-names">BookmarkCard</lookup>
              </closure>
            </binding>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>

