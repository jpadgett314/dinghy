<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="BookmarkFeed" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">16</property>
    <child>
      <object class="GtkScrolledWindow" id="scroll_window">
        <signal name="edge-reached" handler="on_edge_reached" swapped="yes"/>
        <property name="vexpand">True</property>
        <property name="hexpand">True</property>
        <property name="hscrollbar-policy">never</property>
        <property name="child">
          <object class="AdwClampScrollable">
            <property name="maximum-size">760</property>
            <property name="tightening-threshold">560</property>
            <property name="child">
              <object class="GtkListView" id="list">
                <signal name="activate" handler="on_activate" swapped="yes"/>
                <property name="valign">fill</property>
                <property name="single-click-activate">True</property>
                <property name="model">
                  <object class="GtkNoSelection" id="selection">
                    <binding name="model">
                      <lookup name="model">BookmarkFeed</lookup>
                    </binding>
                  </object>
                </property>
                <property name="factory">
                  <object class="GtkSignalListItemFactory" id="factory">
                    <signal name="bind" handler="on_bind" swapped="yes"/>
                    <signal name="setup" handler="on_setup" swapped="yes"/>
                    <signal name="unbind" handler="on_unbind" swapped="yes"/>
                  </object>
                </property>
                <style>
                  <class name="bookmark-feed"/>
                </style>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
