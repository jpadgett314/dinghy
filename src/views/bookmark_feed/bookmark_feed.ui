<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="BookmarkFeed" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">16</property>
    <child>
      <object class="GtkShortcutController">
        <property name="scope">local</property>
        <property name="propagation-phase">capture</property>
        <child>
          <object class="GtkShortcut" id="select_focused_shortcut">
            <property name="trigger">space</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="scroll_window">
        <signal name="edge-reached" handler="on_edge_reached" swapped="yes"/>
        <property name="vexpand">True</property>
        <property name="hexpand">True</property>
        <property name="hscrollbar-policy">never</property>
        <property name="child">
          <object class="AdwClampScrollable">
            <property name="maximum-size">760</property>
            <property name="tightening-threshold">560</property>
            <property name="child">
              <object class="GtkListView" id="list">
                <signal name="activate" handler="on_activate" swapped="yes"/>
                <property name="single-click-activate">True</property>
                <property name="valign">fill</property>
                <property name="model">
                  <object class="GtkMultiSelection" id="selection">
                    <binding name="model">
                      <lookup name="model">BookmarkFeed</lookup>
                    </binding>
                    <signal name="selection-changed" handler="on_selection_changed" swapped="yes"/>
                  </object>
                </property>
                <property name="factory">
                  <object class="GtkBuilderListItemFactory">
                    <property name="resource">/io/github/jpadgett314/Dinghy/views/bookmark_feed/bookmark_feed_item.ui</property>
                  </object>
                </property>
                <style>
                  <class name="bookmark-feed"/>
                </style>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
