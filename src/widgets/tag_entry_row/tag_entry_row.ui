<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="Adw" version="1.9"/>
  <template class="TagEntryRow" parent="AdwPreferencesRow">
    <property name="activatable">False</property>
    <property name="focusable">False</property>
    <style>
      <class name="tag-entry-row"/>
    </style>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="AdwEntryRow" id="entry">
            <binding name="title">
              <lookup name="title">TagEntryRow</lookup>
            </binding>
            <signal name="entry-activated" handler="commit_pending" swapped="yes"/>
            <child type="suffix">
              <object class="GtkButton">
                <property name="icon-name">list-add-symbolic</property>
                <property name="tooltip-text" translatable="yes">Add tag</property>
                <property name="valign">center</property>
                <binding name="sensitive">
                  <closure type="gboolean" function="has_text">
                    <lookup name="text">entry</lookup>
                  </closure>
                </binding>
                <signal name="clicked" handler="commit_pending" swapped="yes"/>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwWrapBox" id="tags_box">
            <property name="visible">False</property>
            <property name="child-spacing">6</property>
            <property name="line-spacing">6</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-bottom">12</property>
            <property name="margin-top">0</property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
